# Nestly demo settings - no secrets here (the demo has no backend, keys or accounts).
# Every API request goes to the in-browser demo backend under this path.
NEXT_PUBLIC_API_URL=/demo-api
# Reuses the site's staging switch: noindex everywhere, empty sitemap, robots.txt blocks crawlers.
NEXT_PUBLIC_APP_ENV=staging
NEXT_TELEMETRY_DISABLED=1
